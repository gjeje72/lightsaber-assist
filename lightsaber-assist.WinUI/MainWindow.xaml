<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="lightsaber_assist.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lightsaber_assist.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="lightsaber-assist.WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,320" Padding="12" RowSpacing="8" ColumnSpacing="12">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="PlayPause_Accel" />
            <KeyboardAccelerator Key="Left" Invoked="PrevFrame_Accel" />
            <KeyboardAccelerator Key="Right" Invoked="NextFrame_Accel" />
            <KeyboardAccelerator Key="Up" Invoked="SpeedUp_Accel" />
            <KeyboardAccelerator Key="Down" Invoked="SpeedDown_Accel" />
        </Grid.KeyboardAccelerators>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="8,6" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <DropDownButton x:Name="ModeButton" Grid.Column="0" Content="Source : aucune">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Importer une vidéo..." Click="Open_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Nouveau match (direct)..." Click="NewMatch_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE714;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rouvrir une analyse existante..." Click="ReopenAnalysis_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="AnalyzeButton" Grid.Column="1" Content="Analyser" Click="Analyze_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Annuler" Click="CancelAnalysis_Click" IsEnabled="False" />
                <ProgressBar x:Name="AnalysisProgress" Grid.Column="3" MinWidth="60" Minimum="0" Maximum="1"
                             VerticalAlignment="Center" />
                <ToggleSwitch x:Name="RealtimeToggle" Grid.Column="4" OnContent="Temps réel" OffContent="Temps réel"
                              Toggled="Realtime_Toggled" MinWidth="0" />
                <DropDownButton x:Name="DisplayMenuButton" Grid.Column="5" Content="Affichage">
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="4" MinWidth="220">
                                <CheckBox x:Name="ShowBoxes" Content="Boîtes" IsChecked="True" Click="OverlayOption_Click" IsTabStop="False" />
                                <CheckBox x:Name="ShowSkeleton" Content="Squelette" IsChecked="True" Click="OverlayOption_Click" IsTabStop="False" />
                                <CheckBox x:Name="ShowCog" Content="Centre de gravité" IsChecked="True" Click="OverlayOption_Click" IsTabStop="False" />
                                <CheckBox x:Name="ShowSabers" Content="Sabres" IsChecked="True" Click="OverlayOption_Click" IsTabStop="False" />
                                <CheckBox x:Name="ShowDistance" Content="Distance" IsChecked="True" Click="OverlayOption_Click" IsTabStop="False" />
                                <Button Content="Définir la zone de combat..." Click="DefineZone_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                                <Button Content="Effacer la zone" Click="ClearZone_Click" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Seuil armé" Margin="0,8,0,0" />
                                <Slider x:Name="ThrustThreshold" Minimum="10" Maximum="100" Value="60" StepFrequency="5"
                                        ValueChanged="ThrustThreshold_ValueChanged" IsTabStop="False" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Grid.Column="6" Content="Exporter JSON" Click="Export_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="2" Grid.Column="0" RowDefinitions="*,Auto,Auto" RowSpacing="8">
            <ScrollViewer x:Name="ZoomHost" Grid.Row="0" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
                <Grid x:Name="VideoSurface" Width="{Binding ViewportWidth, ElementName=ZoomHost}" Height="{Binding ViewportHeight, ElementName=ZoomHost}" Background="Transparent">
                    <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" />
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>

            <Grid x:Name="LivePanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Grid x:Name="LiveTile0" Grid.Column="0" Background="Black" CornerRadius="8">
                    <Image x:Name="LiveImage0" Stretch="Uniform" />
                    <Canvas x:Name="LiveOverlay0" IsHitTestVisible="False" />
                    <TextBlock x:Name="LiveLabel0" Margin="8" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" />
                </Grid>
                <Grid x:Name="LiveTile1" Grid.Column="1" Background="Black" CornerRadius="8">
                    <Image x:Name="LiveImage1" Stretch="Uniform" />
                    <Canvas x:Name="LiveOverlay1" IsHitTestVisible="False" />
                    <TextBlock x:Name="LiveLabel1" Margin="8" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" />
                </Grid>
                <Grid x:Name="LiveTile2" Grid.Column="2" Background="Black" CornerRadius="8">
                    <Image x:Name="LiveImage2" Stretch="Uniform" />
                    <Canvas x:Name="LiveOverlay2" IsHitTestVisible="False" />
                    <TextBlock x:Name="LiveLabel2" Margin="8" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" />
                </Grid>
            </Grid>

            <Border x:Name="LiveBar" Grid.Row="1" Visibility="Collapsed" CornerRadius="12" Padding="12,8" Background="#E6202020">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="Red" />
                        <TextBlock Text="DIRECT" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="MatchText" Grid.Column="1" Foreground="#CCFFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="LiveReview_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE769;" FontSize="16" />
                            <TextBlock Text="Pause et revoir l'action" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Content="Terminer le match" Click="EndMatch_Click" />
                </Grid>
            </Border>

            <Border x:Name="MatchInfoBar" Grid.Row="2" Visibility="Collapsed" CornerRadius="12" Padding="12,8" Background="#E6202020">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,6" Background="#CCB71C1C">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="Fighter1Country" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                            <Image x:Name="Fighter1Flag" Height="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="Fighter1Name" Foreground="White" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MatchTitleText" Grid.Column="1" Foreground="White" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Border Grid.Column="2" CornerRadius="8" Padding="12,6" Background="#CC1B7A2F">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="Fighter2Name" Foreground="White" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Image x:Name="Fighter2Flag" Height="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="Fighter2Country" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="PlayerBar" Grid.Row="1" Background="#E6202020" Padding="8,4">
                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <Style x:Key="PlayerButton" TargetType="Button">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                    <Style x:Key="PlayerChip" TargetType="Button">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </Border.Resources>
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*" Height="26">
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged"
                                IsTabStop="False" VerticalAlignment="Center" />
                        <Canvas x:Name="TimelineMarkers" Height="14" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                        <Button Grid.Column="0" Style="{StaticResource PlayerButton}" Click="PrevFrame_Click"
                                ToolTipService.ToolTip="Image précédente (←)">
                            <FontIcon Glyph="&#xE76B;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource PlayerButton}" Click="PlayPause_Click"
                                ToolTipService.ToolTip="Lecture / Pause (espace)">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PlayerButton}" Click="NextFrame_Click"
                                ToolTipService.ToolTip="Image suivante (→)">
                            <FontIcon Glyph="&#xE76C;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource PlayerButton}" Click="Mute_Click"
                                ToolTipService.ToolTip="Muet">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="18" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="4" Width="80" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="VolumeSlider_ValueChanged" IsTabStop="False" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PositionText" Text="00:00" />
                            <TextBlock Text="/" Opacity="0.7" />
                            <TextBlock x:Name="DurationText" Text="00:00" Opacity="0.7" />
                        </StackPanel>

                        <Button x:Name="BackToLiveButton" Grid.Column="6" Visibility="Collapsed" HorizontalAlignment="Left" Margin="8,0,0,0"
                                Style="{StaticResource PlayerChip}" Background="#33FFFFFF" Click="BackToLive_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="Red" />
                                <TextBlock Text="Retour au direct" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="7" Style="{StaticResource PlayerButton}" Click="ZoomOut_Click"
                                ToolTipService.ToolTip="Zoom -">
                            <FontIcon Glyph="&#xE71F;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="8" Style="{StaticResource PlayerChip}" Click="ZoomReset_Click"
                                Content="100 %" ToolTipService.ToolTip="Réinitialiser le zoom" />
                        <Button Grid.Column="9" Style="{StaticResource PlayerButton}" Click="ZoomIn_Click"
                                ToolTipService.ToolTip="Zoom +">
                            <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                        </Button>
                        <Button x:Name="SpeedButton" Grid.Column="10" Style="{StaticResource PlayerChip}" Content="1x"
                                ToolTipService.ToolTip="Vitesse de lecture">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <StackPanel Width="300" Spacing="10">
                                        <TextBlock Text="Vitesse de lecture" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SpeedText" Text="1.00x" FontSize="22" HorizontalAlignment="Center" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Button Grid.Column="0" Content="-" Tag="-0.25" Click="SpeedStep_Click" Width="36" CornerRadius="18" />
                                            <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.25" Maximum="3" StepFrequency="0.25"
                                                    Value="1" ValueChanged="SpeedSlider_ValueChanged" IsTabStop="False" />
                                            <Button Grid.Column="2" Content="+" Tag="0.25" Click="SpeedStep_Click" Width="36" CornerRadius="18" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Button Content="0,25" Tag="0.25" Click="Speed_Click" CornerRadius="16" />
                                            <Button Content="0,5" Tag="0.5" Click="Speed_Click" CornerRadius="16" />
                                            <Button Content="1,0" Tag="1" Click="Speed_Click" CornerRadius="16" />
                                            <Button Content="1,5" Tag="1.5" Click="Speed_Click" CornerRadius="16" />
                                            <Button Content="2,0" Tag="2" Click="Speed_Click" CornerRadius="16" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="11" Style="{StaticResource PlayerButton}" Click="Fullscreen_Click"
                                ToolTipService.ToolTip="Plein écran">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="Annotations et événements" FontWeight="SemiBold" />
            <ListView x:Name="AnnotationList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="AnnotationList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TimelineEntry">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,4">
                            <Border Grid.Column="0" CornerRadius="10" Padding="8,2" VerticalAlignment="Top"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind TimeText}" FontSize="12" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Spacing="8">
                <ComboBox x:Name="AnnotationTypeBox" HorizontalAlignment="Stretch" SelectedIndex="0" IsTabStop="False" />
                <TextBox x:Name="AnnotationComment" PlaceholderText="Commentaire (optionnel)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Ajouter" Click="AddAnnotation_Click" />
                    <Button Content="Supprimer" Click="DeleteAnnotation_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
